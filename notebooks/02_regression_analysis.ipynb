   ],
   "source": [
    "# Residual\n",
    "y_test_exp = np.expm1(y_test_log)\n",
    "y_pred_exp = np.expm1(y_pred_log)\n",
    "residuals_log = y_test_exp - y_pred_exp\n",
    "\n",
    "sns.residplot(x=y_pred_exp, y=residuals_log, lowess=True, line_kws={'color': 'red'})\n",
    "plt.xlabel('Predicted SalePrice (exp)')\n",
    "plt.ylabel('Residuals')\n",
    "plt.title('Residual Plot Log-Transformed Regression')\n",
    "plt.show()\n"
   ]
